[Unit]
Description=Fleet mention notifications and bot briefings
After=network-online.target

[Service]
# scripts/setup.mjs fills these paths using the current Node and project location.
# The watcher loads the project .env itself, with the same semantics as manual runs.
ExecStart=@NODE@ @WATCHER@
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
