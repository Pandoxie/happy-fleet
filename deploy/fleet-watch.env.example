# Required: the same server used by your Happy sessions.
HAPPY_SERVER_URL=https://happy.example.com
# Paths are relative to the project root; ~/ and absolute paths also work.
# HAPPY_HOME_DIR=~/.happy
# HAPPY_AGENT_DIR=vendor/happy-agent
# HAPPY_AGENT_BIN=vendor/happy-agent/bin/happy-agent.mjs
# FLEET_BOT_MD=bot.md
# FLEET_STATE_FILE=.fleet-watch-state.json
# FLEET_BOT_TITLE='\bbot\b'
# FLEET_ONLY=builder-bot,reviewer-bot
# FLEET_NO_BRIEF=false
# FLEET_STDOUT=false

# Commander session title; the routing handle stays #commander.
# FLEET_COMMANDER_TITLE=commander
# Optional runtime tuning (all numbers are integers).
# Maximum characters per relayed segment
# FLEET_MAX_SEGMENT=8000
# Maximum mentions per pair per window
# FLEET_RATE_MAX=10
# Pair rate-limit window (ms)
# FLEET_RATE_WINDOW_MS=300000
# Quiet time before ending an open turn (ms)
# FLEET_IDLE_FLUSH_MS=30000
# Sequence replay tolerance
# FLEET_REPLAY_MARGIN=300
# Persisted message IDs per session
# FLEET_SEEN_LIMIT=2000
# Heartbeat expiry (ms)
# FLEET_OFFLINE_AFTER_MS=120000
# Maximum local thinking wait (ms)
# FLEET_IDLE_WAIT_MS=1800000
# CLI idle wait timeout (seconds)
# FLEET_CLI_WAIT_TIMEOUT_S=1800
# Outbound retry delay (ms)
# FLEET_RETRY_MS=30000
# Session refresh cooldown (ms)
# FLEET_REFRESH_COOLDOWN_MS=5000
# Socket initial reconnect delay (ms)
# FLEET_RECONNECT_DELAY_MS=1000
# Socket maximum reconnect delay (ms)
# FLEET_RECONNECT_DELAY_MAX_MS=5000
# Heartbeat expiry check interval (ms)
# FLEET_OFFLINE_CHECK_MS=30000
# Open-turn idle check interval (ms)
# FLEET_IDLE_CHECK_MS=5000
# Briefing file reload debounce (ms)
# FLEET_BRIEF_DEBOUNCE_MS=2000
# REST request timeout (ms; 0 preserves unlimited wait)
# FLEET_HTTP_TIMEOUT_MS=0
